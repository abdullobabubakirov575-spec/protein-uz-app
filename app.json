{
  "expo": {
    "name": "Protein.uz",
    "slug": "protein-uz",
    "scheme": "proteinuz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C0C",
    "ios": {
      "bundleIdentifier": "uz.protein.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["uz", "ru", "en"],
        "CFBundleDevelopmentRegion": "uz"
      }
    },
    "android": {
      "package": "uz.protein.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0C0C0C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Protein.uz uses your location to deliver your order to the right address."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
